NEXT_PUBLIC_SITE_URL=https://burifylabs.com
GOOGLE_APPS_SCRIPT_URL=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Paystack hosted checkout (server-only; never use NEXT_PUBLIC_ for secret keys)
