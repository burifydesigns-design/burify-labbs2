NEXT_PUBLIC_SITE_URL=https://burifylabs.com
GOOGLE_APPS_SCRIPT_URL=
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SUPABASE_SECRET_KEY

# Paystack hosted checkout (server-only; never use NEXT_PUBLIC_ for secret keys)
PAYSTACK_SECRET_KEY=
PAYSTACK_EXPECTED_DOMAIN= # set live in Production and test in Preview/Development
PAYMENTS_ENABLED=false
# Random secret of at least 16 characters for the scheduled reconciliation endpoint.
CRON_SECRET=

# Resend transactional invoice and payment receipt email (server-only; sender domain must be verified in Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Burify Solutions <invoices@burifylabs.com>
